# Variables de entorno de la app — copiar a `.env` (gitignored) y
# completar. Todo lo declarado acá es lo que el código puede leer via
# os.environ/os.getenv — los secretos nunca van hardcodeados ni
# commiteados.

APP_NAME=fleetpulse

# URL SQLAlchemy de la base de datos (sqlite local por default):
DATABASE_URL=sqlite:///./app.db
# Postgres: DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/fleetpulse
# MySQL:    DATABASE_URL=mysql+pymysql://user:pass@host:3306/fleetpulse
# (requieren descomentar el driver correspondiente en requirements.txt)

# Auth — JWT en cookie httpOnly (perfil compliance auth). OBLIGATORIO en
# producción; si falta se genera un secreto efímero por proceso.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600

# Orígenes del front permitidos para CORS con credentials (cookies).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Motor de alertas / tracking.
ALERTS_INTERVAL_S=60
SPEED_LIMIT_KMH=120
ROUTE_DEVIATION_M=500

# Archivado de tracking_events: eventos más viejos que la retención se
# mueven a tracking_events_archive (loop cada ARCHIVE_INTERVAL_S, o
# manual por POST /api/tracking/archive).
TRACKING_RETENTION_DAYS=30
TRACKING_ARCHIVE_INTERVAL_S=3600

# Métricas diarias: cada METRICS_INTERVAL_S se upsertea en
# daily_metrics el snapshot del día en curso + el de ayer (final).
# Manual: POST /api/analytics/snapshot; lectura: GET /api/analytics/history.
METRICS_INTERVAL_S=3600

# Notificaciones por email de alertas nuevas — al crearse una alerta
# cuya severidad está en ALERT_EMAIL_SEVERITIES se manda un mail en un
# thread aparte (no bloquea ni el request ni el motor de reglas). Sin
# SMTP_HOST o ALERT_EMAIL_TO queda deshabilitado (no-op).
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=fleetpulse@example.com
#ALERT_EMAIL_TO=ops@example.com,dispatch@example.com
#ALERT_EMAIL_SEVERITIES=critical
# STARTTLS por default (587). Para SSL directo (puerto 465):
#SMTP_SSL=true
#SMTP_TLS=false

# Rate limit de escrituras /api por IP (req/min).
RATE_LIMIT_MAX=20

# Observabilidad: LOG_FORMAT=json → una línea JSON por log (ts, level,
# logger, message + extras como request_id/path/status/ms). Otro valor
# = texto clásico. LOG_LEVEL = nivel del root logger (default INFO).
# El scrape de Prometheus se sirve en GET /metrics (sin auth — en
# producción se protege a nivel de red).
LOG_FORMAT=text
LOG_LEVEL=INFO

# Bus multi-worker (app/bus.py) — con REDIS_URL set:
# · los broadcasts WS (/api/tracking/live) viajan por pub/sub — un
#   tracking update que cae en cualquier réplica llega a los sockets
#   de todas;
# · los loops en-proceso (alertas/archivado/métricas) corren solo en el
#   worker con el lease de líder (SET NX EX + renovación) → se pueden
#   escalar N réplicas todas con RUN_BACKGROUND_LOOPS=true sin duplicar
#   trabajos; si el líder muere el TTL vence y otro toma el liderazgo.
# Sin REDIS_URL → single-process (broadcast local + líder permanente).
# Si Redis está caído al boot, queda deshabilitado con warning.
#REDIS_URL=redis://localhost:6379/0
#REDIS_CHANNEL=fleetpulse:ws
#REDIS_LEADER_KEY=fleetpulse:leader
#REDIS_LEADER_TTL_S=30

# Runtime / deploy (Dockerfile + docker-compose.yml):
# PORT/UVICORN_WORKERS = bind de uvicorn; FORWARDED_ALLOW_IPS = proxies
# confiables para X-Forwarded-* (rate-limit por IP y logs la usan).
# RUN_BACKGROUND_LOOPS=false apaga los loops en-proceso (alertas,
# archivado, métricas) del worker — sin Redis sigue siendo el flag para
# elegir qué réplica corre los loops.
# SEED_DEMO=false arranca con tablas vacías (producción) — el primer
# usuario registrado queda admin.
PORT=4000
UVICORN_WORKERS=1
#FORWARDED_ALLOW_IPS=10.0.0.0/8
RUN_BACKGROUND_LOOPS=true
SEED_DEMO=true

# Postgres del stack docker-compose (db service — la api usa
# postgresql+psycopg2://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB):
#POSTGRES_DB=fleetpulse
#POSTGRES_USER=fleetpulse
#POSTGRES_PASSWORD=change-me-to-a-long-random-string
